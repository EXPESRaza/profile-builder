# Copy to .env.local and fill in. .env* files are gitignored.

# Which provider to use: openai | anthropic | openrouter   (default: openai)
LLM_PROVIDER=openai

# Model id for the chosen provider. Defaults per provider if unset:
#   openai     -> gpt-4o-mini
#   anthropic  -> claude-haiku-4-5-20251001
#   openrouter -> openai/gpt-4o-mini
# LLM_MODEL=gpt-4o-mini

# Only the key for the selected provider is required.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# Where the single-user profile is persisted (default: ./data/profile.json)
# PROFILE_STORE_PATH=./data/profile.json
